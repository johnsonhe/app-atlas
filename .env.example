# Uses the existing Google Cloud application-default credentials locally.
# On Cloud Run, uses the service account. Grant that account roles/aiplatform.user.
GOOGLE_CLOUD_PROJECT=ieor-4570
GOOGLE_CLOUD_LOCATION=global
MODEL=gemini-3.5-flash
RESEARCHER_MODEL=gemini-3.5-flash-lite
# Alternatively, set GEMINI_API_KEY to use the Gemini Developer API.
# GEMINI_API_KEY=
PORT=8080
MAX_RESEARCHERS=6
MAX_RESEARCHER_TURNS=5
MAX_FOLLOWUP_ROUNDS=2
REQUEST_TIMEOUT_SECONDS=270
